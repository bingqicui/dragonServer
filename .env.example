# 游戏服务器环境变量配置示例
# 复制此文件为 .env 并修改相应值

# ==================== 服务器配置 ====================

# 服务器监听端口（默认 3000）
PORT=3000

# ==================== 数据库配置 ====================

# MongoDB 连接串（默认本地）
MONGO_URI=mongodb://localhost:27017/gameServer

# 使用内存数据库（开发用，重启清空数据）
# 启用后无需运行 MongoDB 进程
ENABLE_MEMORY_DB=false

# ==================== JWT 认证配置 ====================

# JWT 签名密钥（生产环境必须修改为复杂随机字符串）
# 推荐至少 32 位，包含字母、数字、特殊字符
JWT_SECRET=change_this_secret

# JWT 过期时间（默认 7 天）
# 格式：数字+单位（s=秒, m=分钟, h=小时, d=天）
JWT_EXPIRES_IN=7d

# ==================== 网关签名配置 ====================

# 网关信封签名密钥（与前端 GATEWAY_SIGN_KEY / getRequestSecret() 对齐）
# 生产环境必须修改，并同步前端 GlobalDefine.ts
GATEWAY_SIGN_KEY=51E3D400670CC4D9C82A49EE5C1969D1

# autoLogin 接口返回的网关地址（前端会用此地址发送后续请求）
# 开发环境：本机 IP + 端口
# 生产环境：公网域名 + /gateway
GATEWAY_PUBLIC_URL=http://localhost:3000/gateway

# 服务器名称（autoLogin 接口返回，前端显示用）
SERVER_NAME=初入幻想

# 开服时间（autoLogin 接口返回）
OPEN_SERVER_TIME=2026-10-01T00:00:00Z

# ==================== 第三方登录配置 ====================

# 微信登录（可选，不配置则第三方登录失败）
# 获取方式：微信公众平台 -> 开发 -> 开发者ID
WECHAT_APPID=
WECHAT_SECRET=

# Google 登录（可选）
# 获取方式：Google Cloud Console -> 凭据 -> OAuth 2.0 客户端 ID
GOOGLE_CLIENT_ID=

# 第三方登录测试桩（开发用，不联网返回确定性测试数据）
# 启用后微信/Google 登录不会真正调用第三方接口
AUTH_STUB=0

# ==================== 平台配置（未消费，预留） ====================

# 平台 ID（当前仅被未接线的 roleArchive.ts 读取）
PLATFORM_ID=

# ==================== 开发调试配置 ====================

# 启动器环境变量（仅 scripts/dev.mjs 使用）

# MongoDB 可执行文件路径（默认 ../serverApps/mongodb/bin/mongod.exe）
# MONGO_BIN=../serverApps/mongodb/bin/mongod.exe

# MongoDB 数据目录（默认 ../serverApps/mongodb/data）
# MONGO_DB_PATH=../serverApps/mongodb/data

# MongoDB 端口（默认 27017）
# MONGO_PORT=27017

# 端口接管（默认启用，27017/服务器端口被占用时先关闭旧进程再启动）
# 关闭：MONGO_TAKEOVER=0 / SERVER_TAKEOVER=0
# MONGO_TAKEOVER=1
# SERVER_TAKEOVER=1

# 只检测不启动（排查用）
# DEV_DRY_RUN=0

# ==================== 生产部署注意事项 ====================

# 1. 必须修改的配置（不能用默认值）：
#    - JWT_SECRET（推荐至少 32 位随机字符串）
#    - GATEWAY_SIGN_KEY（推荐至少 32 位随机字符串）
#    - MONGO_URI（改为生产数据库地址，带认证）

# 2. 生产 MongoDB 连接串示例：
#    MONGO_URI=mongodb://username:password@host1:27017,host2:27017/gameServer?replicaSet=rs0&authSource=admin

# 3. GATEWAY_PUBLIC_URL 改为公网地址：
#    GATEWAY_PUBLIC_URL=https://game.example.com/gateway

# 4. 第三方登录配置（如需要）：
#    - 申请微信/Google 开放平台账号
#    - 配置 WECHAT_APPID / WECHAT_SECRET / GOOGLE_CLIENT_ID
#    - 关闭测试桩：AUTH_STUB=0

# 5. 不要把 .env 文件提交到 Git（已在 .gitignore）
